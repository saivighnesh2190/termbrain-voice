# Copy to .env and `source .env` (never commit the real key)
export GNANI_API_KEY=your-key-from-app.gnani.ai
# Optional overrides
export TBV_OLLAMA_MODEL=gemma3:4b
export TBV_TTS_VOICE=Shivani        # any Timbre v3.0 voice: Kalpana, Avinash, Lakshmi...
export TBV_STT_LANGS=te-IN,en-IN    # up to 4 hint languages, or indic-auto
